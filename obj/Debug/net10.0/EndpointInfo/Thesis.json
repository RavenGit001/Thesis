{
  "openapi": "3.1.1",
  "info": {
    "title": "Thesis | v1",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://0.0.0.0:7137"
    },
    {
      "url": "http://0.0.0.0:5191"
    }
  ],
  "paths": {
    "/api/Detection": {
      "post": {
        "tags": [
          "Detection"
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/DetectionLog"
              }
            },
            "text/json": {
              "schema": {
                "$ref": "#/components/schemas/DetectionLog"
              }
            },
            "application/*+json": {
              "schema": {
                "$ref": "#/components/schemas/DetectionLog"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/Detection/latest": {
      "get": {
        "tags": [
          "Detection"
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/Detection/history": {
      "get": {
        "tags": [
          "Detection"
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/Sensor": {
      "post": {
        "tags": [
          "Sensor"
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SensorReading"
              }
            },
            "text/json": {
              "schema": {
                "$ref": "#/components/schemas/SensorReading"
              }
            },
            "application/*+json": {
              "schema": {
                "$ref": "#/components/schemas/SensorReading"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/Sensor/latest": {
      "get": {
        "tags": [
          "Sensor"
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "DetectionLog": {
        "type": "object",
        "properties": {
          "id": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "breadResultsJson": {
            "type": "string"
          },
          "imageUrl": {
            "type": [
              "null",
              "string"
            ]
          },
          "timestamp": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "SensorReading": {
        "type": "object",
        "properties": {
          "id": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "temperature": {
            "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?(?:[eE][+-]?\\d+)?$",
            "type": [
              "number",
              "string"
            ],
            "format": "double"
          },
          "humidity": {
            "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?(?:[eE][+-]?\\d+)?$",
            "type": [
              "number",
              "string"
            ],
            "format": "double"
          },
          "timestamp": {
            "type": "string",
            "format": "date-time"
          }
        }
      }
    }
  },
  "tags": [
    {
      "name": "Detection"
    },
    {
      "name": "Sensor"
    }
  ]
}